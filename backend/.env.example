# ---------------------------------------------------------------------------
# PaperPay backend environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed or shared — it holds live credentials.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# PostgreSQL / Neon connection string. Keep `sslmode` out of the URL: TLS
# verification is controlled by DB_SSL_* below so the app is the single source
# of truth for certificate checking.
DATABASE_URL=postgresql://user:password@host/dbname

# Set to "false" ONLY for local development against a self-signed certificate.
# Leave unset (or "true") so the server certificate is verified.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Set to "false" to disable TLS entirely (local Postgres without SSL).
# DB_SSL=true

# --- HTTP ---------------------------------------------------------------------
PORT=3000

# Comma-separated browser origins allowed to call the API. Requests without an
# Origin header (curl, the mobile app) are always allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Auth ---------------------------------------------------------------------
# Used to sign the app's own session tokens returned by /api/auth/verify-token.
# Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- Firebase Admin (phone OTP verification) ----------------------------------
# Service-account values from the Firebase console. FIREBASE_PRIVATE_KEY keeps
# its literal "\n" escapes when placed in .env.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Cloudinary (file uploads) -------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (online payments) ------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
